<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.messiq.client.controller.LoginController"
      alignment="CENTER"
      spacing="16"
      styleClass="auth-root"
      prefWidth="480"
      prefHeight="640">

    <padding>
        <Insets top="32" right="36" bottom="32" left="36"/>
    </padding>

    <!-- Header Brand -->
    <VBox alignment="CENTER" spacing="6">
        <Label text="⚡ messiQ" styleClass="auth-title"/>
        <Label text="Real-Time Messenger Application" styleClass="auth-subtitle"/>
        <Label text="Graphic Era Hill University • BCA Group 24" styleClass="auth-meta"/>
    </VBox>

    <!-- Navigation Tabs -->
    <HBox spacing="8" styleClass="auth-tabs-container">
        <Button fx:id="tabLoginBtn" text="Sign In" onAction="#showLoginForm" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tab-btn, active-tab"/>
        <Button fx:id="tabRegisterBtn" text="Register" onAction="#showRegisterForm" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tab-btn"/>
    </HBox>

    <!-- Alert Label -->
    <Label fx:id="alertLabel" visible="false" managed="false" maxWidth="Infinity" wrapText="true"/>

    <!-- Login Form -->
    <VBox fx:id="loginFormBox" spacing="14" maxWidth="Infinity">
        <VBox spacing="6">
            <Label text="Username or Email" styleClass="field-label"/>
            <TextField fx:id="loginUsernameField" promptText="e.g. hridyansh" styleClass="input-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="loginPasswordField" promptText="••••••••" styleClass="input-field"/>
        </VBox>

        <!-- Demo Accounts Quick Fill -->
        <VBox spacing="6">
            <Label text="Demo Accounts:" styleClass="field-label-sm"/>
            <HBox spacing="8">
                <Button text="hridyansh" onAction="#fillDemoHridyansh" styleClass="demo-chip"/>
                <Button text="megha" onAction="#fillDemoMegha" styleClass="demo-chip"/>
                <Button text="janmejay" onAction="#fillDemoJanmejay" styleClass="demo-chip"/>
            </HBox>
        </VBox>

        <Button fx:id="loginSubmitBtn" text="Sign In" onAction="#handleLogin" maxWidth="Infinity" defaultButton="true" styleClass="btn-primary"/>
    </VBox>

    <!-- Registration Form -->
    <VBox fx:id="registerFormBox" spacing="12" maxWidth="Infinity" visible="false" managed="false">
        <VBox spacing="4">
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="regUsernameField" promptText="e.g. alex24" styleClass="input-field"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="regDisplayNameField" promptText="e.g. Alex Hunter" styleClass="input-field"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="regEmailField" promptText="alex@gehu.ac.in" styleClass="input-field"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="regPasswordField" promptText="Minimum 6 characters" styleClass="input-field"/>
        </VBox>

        <Button fx:id="regSubmitBtn" text="Create Account" onAction="#handleRegister" maxWidth="Infinity" styleClass="btn-primary"/>
    </VBox>

</VBox>
