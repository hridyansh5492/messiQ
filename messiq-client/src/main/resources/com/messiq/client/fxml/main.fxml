<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.messiq.client.controller.MainChatController"
            styleClass="main-root"
            prefWidth="1080"
            prefHeight="720">

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox styleClass="sidebar-container" prefWidth="320" minWidth="280">
            <!-- User Profile Header -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="sidebar-header">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <StackPane>
                    <Circle fx:id="currentUserAvatarCircle" radius="20" styleClass="avatar-circle"/>
                    <Circle fx:id="currentUserStatusCircle" radius="5" styleClass="status-dot-sub" StackPane.alignment="BOTTOM_RIGHT"/>
                </StackPane>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="currentUserNameLabel" text="User Name" styleClass="profile-name"/>
                    <Label fx:id="currentUserHandleLabel" text="@username" styleClass="profile-handle"/>
                </VBox>
                <Button text="⇥" onAction="#handleLogout" styleClass="logout-btn" tooltip="$logoutTooltip">
                    <tooltip>
                        <Tooltip fx:id="logoutTooltip" text="Sign Out"/>
                    </tooltip>
                </Button>
            </HBox>

            <!-- Search Bar -->
            <VBox styleClass="search-wrapper">
                <padding>
                    <Insets top="8" right="14" bottom="10" left="14"/>
                </padding>
                <TextField fx:id="searchField" promptText="🔍 Search users or chats..." styleClass="search-field"/>
            </VBox>

            <!-- User Cards Scroll List -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="user-scroll-pane">
                <VBox fx:id="userListContainer" spacing="4" styleClass="user-list-vbox">
                    <padding>
                        <Insets top="4" right="10" bottom="8" left="10"/>
                    </padding>
                </VBox>
            </ScrollPane>

            <!-- Bottom Connection Status -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-footer">
                <padding>
                    <Insets top="10" right="16" bottom="10" left="16"/>
                </padding>
                <Circle fx:id="wsStatusCircle" radius="4" styleClass="status-dot-sub"/>
                <Label fx:id="wsStatusLabel" text="Connecting..." styleClass="status-footer-text"/>
            </HBox>
        </VBox>
    </left>

    <!-- CENTER CHAT AREA -->
    <center>
        <StackPane styleClass="chat-center-stack">
            <!-- Empty State View -->
            <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="16" styleClass="empty-state-vbox">
                <Label text="⚡" styleClass="empty-icon"/>
                <Label text="Welcome to messiQ" styleClass="empty-title"/>
                <Label text="Select a contact from the sidebar to start real-time messaging." styleClass="empty-desc"/>
                <HBox alignment="CENTER" spacing="12">
                    <Label text="• WebSocket Real-Time" styleClass="badge-pill"/>
                    <Label text="• MySQL Persistence" styleClass="badge-pill"/>
                    <Label text="• Photo Sharing" styleClass="badge-pill"/>
                </HBox>
            </VBox>

            <!-- Active Conversation View -->
            <VBox fx:id="activeChatBox" visible="false" managed="false" styleClass="active-chat-vbox">
                <!-- Chat Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chat-top-header">
                    <padding>
                        <Insets top="14" right="20" bottom="14" left="20"/>
                    </padding>
                    <Circle fx:id="activePeerStatusCircle" radius="6"/>
                    <VBox spacing="2">
                        <Label fx:id="activePeerNameLabel" text="Contact Name" styleClass="active-header-name"/>
                        <Label fx:id="activePeerStatusLabel" text="Offline" styleClass="active-header-status"/>
                    </VBox>
                </HBox>

                <!-- Message Feed -->
                <ScrollPane fx:id="messageScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="message-scroll-pane">
                    <VBox fx:id="messageContainer" spacing="8" styleClass="message-vbox">
                        <padding>
                            <Insets top="16" right="20" bottom="16" left="20"/>
                        </padding>
                    </VBox>
                </ScrollPane>

                <!-- Attachment Preview Bar -->
                <HBox fx:id="attachmentPreviewBar" alignment="CENTER_LEFT" spacing="10" styleClass="attachment-bar" visible="false" managed="false">
                    <padding>
                        <Insets top="6" right="20" bottom="6" left="20"/>
                    </padding>
                    <Label text="📎"/>
                    <Label fx:id="attachedFileNameLabel" text="file.png" styleClass="attached-name"/>
                    <Button text="✕" onAction="#clearAttachment" styleClass="chip-remove-btn"/>
                </HBox>

                <!-- Chat Input Footer -->
                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="chat-footer-bar">
                    <padding>
                        <Insets top="12" right="20" bottom="16" left="20"/>
                    </padding>
                    <Button fx:id="attachBtn" text="📎" onAction="#handleAttachFile" styleClass="btn-icon"/>
                    <TextField fx:id="messageInputField" promptText="Write a message... (Press Enter to send)" onAction="#handleSendMessage" HBox.hgrow="ALWAYS" styleClass="chat-input-field"/>
                    <Button fx:id="sendBtn" text="Send ➤" onAction="#handleSendMessage" defaultButton="true" styleClass="btn-primary-send"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
